# ~/.dotfiles/zsh/aliases.zsh

# ----------------------
# Git Aliases
# ----------------------
alias ga='git add'
alias gaa='git add .'

alias gs='git status'
alias gss='git status -s'

alias gcb='git checkout -b'
alias gc='git checkout'
alias gb='git branch'

alias gcm='git commit -m'

alias gl='git pull'

alias glo='git log --oneline'

# ----------------------
# Others
# ----------------------
alias ll='ls -la'
